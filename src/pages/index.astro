---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import { project } from "../data/project";
import { products } from "../data/products";

const wa = (msg: string) =>
  `https://wa.me/${project.brand.whatsapp}?text=${encodeURIComponent(msg)}`;

const generalWa = wa(`Hola, quiero conocer los moños de ${project.brand.name}.`);
const year = new Date().getFullYear();
---

<Layout title={`${project.brand.name} | ${project.brand.slogan}`} description={project.brand.subtitle}>
  <header class="site-header">
    <div class="header-inner">
      <a class="logo" href="#inicio">
        <span class="logo-mark" aria-hidden="true">🎀</span>
        <span class="logo-text">{project.brand.name}</span>
      </a>
      <nav class="nav" aria-label="Navegación principal">
        <a href="#catalogo">Catálogo</a>
        <a href="#promos">Promos</a>
        <a href="#pedir">Cómo pedir</a>
        <a href="#marca">La marca</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <a class="btn small" href={generalWa} target="_blank" rel="noopener">WhatsApp</a>
    </div>
  </header>

  <main>
    <section id="inicio" class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="badge">{project.brand.location}</span>
          <h1>{project.brand.name}</h1>
          <p class="slogan">{project.brand.slogan}</p>
          <p class="lead">{project.brand.subtitle}</p>
          <div class="hero-actions">
            <a class="btn primary" href={generalWa} target="_blank" rel="noopener">Pedir por WhatsApp</a>
            <a class="btn ghost" href="#catalogo">Ver catálogo</a>
          </div>
          <ul class="hero-highlights">
            {project.highlights.map((h) => (
              <li><strong>{h.label}:</strong> {h.value}</li>
            ))}
          </ul>
        </div>

        <div class="hero-visual">
          <div class="bow-card">
            <svg viewBox="0 0 240 240" role="img" aria-label="Moño artesanal">
              <defs>
                <linearGradient id="bowPink" x1="0" x2="1" y1="0" y2="1">
                  <stop offset="0%" stop-color="#ffd7e1" /><stop offset="100%" stop-color="#d94f70" />
                </linearGradient>
                <linearGradient id="bowGold" x1="0" x2="1" y1="0" y2="1">
                  <stop offset="0%" stop-color="#f4d99b" /><stop offset="100%" stop-color="#b9863c" />
                </linearGradient>
              </defs>
              <path d="M120 120 C82 68, 28 78, 44 120 C28 162, 82 172, 120 120 Z" fill="url(#bowPink)" opacity=".95" />
              <path d="M120 120 C158 68, 212 78, 196 120 C212 162, 158 172, 120 120 Z" fill="url(#bowPink)" opacity=".95" />
              <path d="M104 132 C92 168, 76 190, 58 208" fill="none" stroke="url(#bowPink)" stroke-width="14" stroke-linecap="round" />
              <path d="M136 132 C148 168, 164 190, 182 208" fill="none" stroke="url(#bowPink)" stroke-width="14" stroke-linecap="round" />
              <circle cx="120" cy="120" r="20" fill="url(#bowGold)" />
              <circle cx="120" cy="120" r="10" fill="#fff8f1" opacity=".55" />
            </svg>
            <div class="floating-pill one">Artesanal</div>
            <div class="floating-pill two">Personalizado</div>
            <div class="floating-pill three">12 – 20 Bs.</div>
          </div>
        </div>
      </div>
    </section>

    <Section id="catalogo" eyebrow="Catálogo" title="Elige tu moño">
      <div class="product-grid">
        {products.map((p) => (
          <article class="card product-tile">
            {p.img
              ? <img class="product-img" src={p.img} alt={p.name} loading="lazy" width="600" height="600" />
              : <div class="product-img placeholder" aria-hidden="true">🎀</div>}
            <div class="product-body">
              <span class="pill">{p.line}</span>
              <h4>{p.name}</h4>
              <span class="price">{p.price}</span>
              <a class="btn primary" href={wa(`Hola, quiero el moño "${p.name}".`)} target="_blank" rel="noopener">
                Pedir este
              </a>
            </div>
          </article>
        ))}
      </div>
    </Section>
    
    <Section id="promos" eyebrow="Promos" title="Packs para regalar">
      <div class="grid cards-3">
        {project.promos.map((p) => (
          <article class="card">
            <h3>{p.name}</h3>
            <p class="muted">{p.detail}</p>
            <p style="font-family:'Playfair Display',serif;font-size:1.6rem;color:#c94267;margin:.25rem 0 .75rem;">{p.price}</p>
            <a class="btn ghost" href={wa(`Hola, quiero el ${p.name}.`)} target="_blank" rel="noopener">Lo quiero</a>
          </article>
        ))}
      </div>
    </Section>

    <Section id="pedir" eyebrow="Fácil" title="Cómo pedir en 3 pasos">
      <div class="grid cards-3">
        {project.steps.map((s) => (
          <article class="card mini-card">
            <span class="number">{s.n}</span>
            <div>
              <h4>{s.title}</h4>
              <p class="muted" style="margin:0;">{s.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </Section>

    <Section id="marca" eyebrow="La marca" title="Hecho con cariño">
      <article class="card">
        <p style="font-size:1.1rem;max-width:70ch;">{project.about}</p>
        <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem;">
          {project.values.map((v) => <span class="pill">{v}</span>)}
        </div>
      </article>
    </Section>

    <section id="cierre" class="section closing-section">
      <div class="container">
        <div class="verse-card">
          <span class="eyebrow">Cierre</span>
          <h2>Hecho con fe y cariño</h2>

          <p class="quote">“El que siembra llorando, cosecha gozando; el que trabaja con amor, recibe con alegría.”</p>
          <p class="quote">“El Señor tu Dios bendecirá todo lo que emprendas y todo trabajo de tus manos.”</p>
          <cite>— Deuteronomio 28:12</cite>

          <p class="closing-message">Cada moño se hace con esfuerzo, dedicación y cariño. Sembramos con amor, cosechamos con gozo —y con fe en que Dios bendice el trabajo de las manos.</p>
          <strong>— Estivaliz Flores Machado</strong>
        </div>
      </div>
    </section>
    
  </main>

  <footer id="contacto" class="site-footer">
    <div class="container footer-grid">
      <div>
        <h3>{project.brand.name}</h3>
        <p>{project.brand.slogan}</p>
        <p>{project.brand.location}</p>
      </div>
      <div>
        <h4>Contacto</h4>
        <a href={generalWa} target="_blank" rel="noopener">Escribir por WhatsApp</a>
        <p>Pedidos y entrega en Trinidad.</p>
      </div>
    </div>
    <div class="footer-bottom"><p>© {year} {project.brand.name}.</p></div>
  </footer>
</Layout>