---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<section id={id} class="section">
  <div class="container">
    <div class="section-head">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2>{title}</h2>
    </div>
    <slot />
  </div>
</section>